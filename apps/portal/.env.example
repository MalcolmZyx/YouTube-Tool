# Copy to `.env.local` (git-ignored). Both values are public by design: row-level security in the database,
# not secrecy, is what protects the data. NEVER put the service key (or any secret) in this app.
#
# Local Supabase: run `npx supabase status -o env` from the repository root and copy API_URL and ANON_KEY.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
