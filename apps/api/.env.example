# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is git-ignored; never commit real keys.

# YouTube Data API v3 key. Create one in Google Cloud Console (APIs & Services > Credentials)
# and restrict it to "YouTube Data API v3".
YOUTUBE_API_KEY=your_api_key_here
# Optional: your project daily YouTube quota in units (default 10000), shown as the meter in the sidebar
# YOUTUBE_DAILY_QUOTA=10000

# Client portal (optional). The URL of the Supabase API and its SERVICE key. The service key bypasses all access rules:
# keep it only here, never in the portal app, never committed. Local values come from `npx supabase status`.
# PORTAL_URL=http://127.0.0.1:54321
# PORTAL_SERVICE_KEY=

# MongoDB, for the public YouTube data (needed for tags, descriptions and thumbnails). Local values match docker-compose.yml.
# MONGO_URL=mongodb://ytstudio:ytstudio_dev@127.0.0.1:27017/?authSource=admin

# Optional settings (defaults shown).
# Reload the server when code changes. Local development only.
# DEBUG=false
# PORT=5000
# Comma-separated browser origins allowed to call the API and to send state-changing requests.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated host names the server answers to (blocks DNS rebinding).
# ALLOWED_HOSTS=localhost,127.0.0.1
# Serve interactive docs at /docs. Turn off on any shared host.
# DOCS_ENABLED=true
# Postgres connection (the default matches docker-compose.yml, development only).
# DATABASE_URL=postgresql+psycopg://ytstudio:ytstudio_dev@127.0.0.1:5432/ytstudio
# Upload limits: file size in MB, and number of videos per export.
# MAX_UPLOAD_MB=5
# MAX_ROWS=5000
