# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is git-ignored; never commit real keys.

# YouTube Data API v3 key. Create one in Google Cloud Console (APIs & Services > Credentials)
# and restrict it to "YouTube Data API v3".
YOUTUBE_API_KEY=your_api_key_here

# Optional settings (defaults shown).
# Reload the server when code changes. Local development only.
# DEBUG=false
# PORT=5000
# Comma-separated browser origins allowed to call the API and to send state-changing requests.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated host names the server answers to (blocks DNS rebinding).
# ALLOWED_HOSTS=localhost,127.0.0.1
# Serve interactive docs at /docs. Turn off on any shared host.
# DOCS_ENABLED=true
# Upload limits: file size in MB, and number of videos per export.
# MAX_UPLOAD_MB=5
# MAX_ROWS=5000
